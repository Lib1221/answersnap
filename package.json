    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/asap": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bungee-shade": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/elsie": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
