  "guide_cf_1": {
    "message": "16 ቁምፊዎች። ከጣሊያን ውጭ ለተወለዱ ሰዎች ከ12 እስከ 15 ያሉት ቁምፊዎች Z እና የአገሩ ሦስት አሃዞች ናቸው (የኢትዮጵያ Z315 ነው)።"
  },
  "guide_cf_2": {
    "message": "ፖርታሎች ጊዜያዊ ኮድ ማስላት ይችላሉ፣ ነገር ግን ትክክለኛውን የሚሰጡት Agenzia delle Entrate ወይም የጣሊያን ኤምባሲ ብቻ ናቸው። ትክክለኛው ካለዎት እሱን ይጠቀሙ።"
  },
  "guide_cf_title": {
    "message": "Codice fiscale"
  },
  "guide_dov_1": {
    "message": "ተመጣጣኝነት: ከጣሊያን ኤምባሲ የሚገኝ Dichiarazione di Valore (DOV)፣ ወይም የ CIMEA የተመጣጣኝነት መግለጫ (Statement of Comparability)።"
  },
  "guide_dov_2": {
    "message": "ትክክለኛነት: የ CIMEA የማረጋገጫ መግለጫ (Statement of Verification)፣ ሕጋዊ ማረጋገጫ፣ ወይም አፖስቲል። ብዙ ዩኒቨርሲቲዎች በቅድመ ምዝገባ ጊዜ እነዚህን አማራጭ ያደርጓቸዋል፣ ነገር ግን በምዝገባ ጊዜ ይጠይቋቸዋል።"
  },
  "guide_dov_title": {
    "message": "የዲግሪዎ እውቅና"
  },
  "guide_dsu_1": {
    "message": "በቤተሰብዎ አባላት፣ ገቢ እና በውጭ አገር ባለ ንብረት (የአምናው የቀደመው ዓመት) ላይ የተመሰረተ፣ በ CAF በኩል የሚዘጋጅ ISEE parificato ያስፈልግዎታል።"
  },
  "guide_dsu_2": {
    "message": "ሰነዶች በአገርዎ ባሉ የጣሊያን ባለሥልጣናት መሰጠት ወይም ሕጋዊ መደረግ፣ እና ወደ ጣሊያንኛ መተርጎም አለባቸው። የራስ መግለጫዎች ተቀባይነት የላቸውም።"
  },
  "guide_dsu_3": {
    "message": "ጥሪዎች ብዙውን ጊዜ በጁን አካባቢ ይከፈታሉ፣ እና በጁላይ እና በሴፕቴምበር መካከል ይዘጋሉ። ISEE ቀድመው ይጀምሩ: ሳምንታት ይወስዳል።"
  },
  "guide_dsu_title": {
    "message": "የክልል ስኮላርሺፖች (DSU: ER.GO, ESU, EDISU, DiSCo, DSU Toscana)"
  },
  "guide_iyt_1": {
    "message": "ስሞች የሚወሰዱት ከፓስፖርቱ MRZ ነው። የእንግሊዝኛ B2፣ አንድ ገጽ CV፣ 59 ሰከንድ ወይም ከዚያ ያነሰ ቪዲዮ፣ እና GPA ያለበት የውጤት ማስረጃዎ።"
  },
  "guide_iyt_title": {
    "message": "Invest Your Talent in Italy"
  },
  "guide_maeci_1": {
    "message": "በ studyinitaly.esteri.it ላይ ያመልክቱ፤ የ2026/27 ጥሪ በማርች ተዘግቷል። የዕድሜ ገደቦች: ለማስተርስ 28፣ ለዶክትሬት 30።"
  },
  "guide_maeci_2": {
    "message": "ጣሊያንኛ ወይም እንግሊዝኛ በ B2 ደረጃ። ለመመዝገብ ፓስፖርትዎ ያስፈልጋል።"
  },
  "guide_maeci_title": {
    "message": "የጣሊያን መንግሥት (MAECI) ስኮላርሺፖች"
  },
  "guide_universitaly_1": {
    "message": "ስሞችን በፓስፖርቱ ላይ እንዳሉት በትክክል፣ ያለ አክሰንት በላቲን ፊደላት ይጻፉ፤ የቤተሰብ ስም ከሌለዎት XXX ይጻፉ። ካስቀመጡ በኋላ መቀየር አይቻልም።"
  },
  "guide_universitaly_2": {
    "message": "የትውልድ ቀን ሦስት ተቆልቋይ ዝርዝሮች ነው (ቀን፣ ወር፣ ዓመት)። ስልክ ከአገር ኮድ ጋር።"
  },
  "guide_universitaly_3": {
    "message": "የፊት ፎቶ እና ፓስፖርትዎን ይስቀሉ: PDF፣ JPEG፣ ወይም PNG፣ ቢበዛ 10 MB። በአንድ የትምህርት ዘመን አንድ ማመልከቻ ብቻ።"
  },
  "guide_universitaly_title": {
    "message": "የ Universitaly ቅድመ ምዝገባ (ከአውሮፓ ኅብረት ውጭ ላሉ ተማሪዎች)"
  },
  "guide_uploads_1": {
    "message": "PDF አስተማማኝ ምርጫ ነው። አክሰንት ወይም ልዩ ቁምፊዎች የሌላቸው የፋይል ስሞችን ይጠቀሙ። ገደቡ ብዙውን ጊዜ በአንድ ፋይል 10 MB ነው።"
