  "guide_cf_1": {
    "message": "16 characters. For people born abroad, characters 12 to 15 are Z and three digits for the country (Ethiopia is Z315)."
  },
  "guide_cf_2": {
    "message": "Portals can compute a provisional code, but only the Agenzia delle Entrate or an Italian embassy issues the real one. Use the real one when you have it."
  },
  "guide_cf_title": {
    "message": "Codice fiscale"
  },
  "guide_dov_1": {
    "message": "Comparability: a Dichiarazione di Valore (DOV) from the Italian embassy, or a CIMEA Statement of Comparability."
  },
  "guide_dov_2": {
    "message": "Authenticity: a CIMEA Statement of Verification, legalization, or apostille. Many universities make these optional at pre-enrolment but ask for them at enrolment."
  },
  "guide_dov_title": {
    "message": "Recognition of your degree"
  },
  "guide_dsu_1": {
    "message": "You need an ISEE parificato, made through a CAF, based on your family composition, income, and property abroad (the year before last)."
  },
  "guide_dsu_2": {
    "message": "Documents must be issued or legalized by the Italian authorities in your country and translated into Italian. Self-declarations are not accepted."
  },
  "guide_dsu_3": {
    "message": "Calls usually open around June and close between July and September. Start the ISEE early: it takes weeks."
  },
  "guide_dsu_title": {
    "message": "Regional scholarships (DSU: ER.GO, ESU, EDISU, DiSCo, DSU Toscana)"
  },
  "guide_iyt_1": {
    "message": "Names come from the passport MRZ. English B2, a one-page CV, a video of 59 seconds or less, and your transcript with the GPA."
  },
  "guide_iyt_title": {
    "message": "Invest Your Talent in Italy"
  },
  "guide_maeci_1": {
    "message": "Apply at studyinitaly.esteri.it; the 2026/27 call closed in March. Age limits: 28 for master's, 30 for PhD."
  },
  "guide_maeci_2": {
    "message": "Italian or English at B2 level. Your passport is needed to register."
  },
  "guide_maeci_title": {
    "message": "Italian Government (MAECI) scholarships"
  },
  "guide_universitaly_1": {
    "message": "Names exactly as in the passport, in Latin letters without accents; write XXX if you have no surname. They cannot be changed after saving."
  },
  "guide_universitaly_2": {
    "message": "Birth date is three dropdowns (day, month, year). Phone with the country code."
  },
  "guide_universitaly_3": {
    "message": "Upload a face photo and your passport: PDF, JPEG, or PNG, 10 MB at most. One application per academic year."
  },
  "guide_universitaly_title": {
    "message": "Universitaly pre-enrolment (non-EU students)"
  },
  "guide_uploads_1": {
    "message": "PDF is the safe choice. Use file names without accents or special characters. Limits are often 10 MB per file."
  },
  "guide_uploads_2": {
    "message": "On some portals (Padua, Polimi) documents can no longer be changed after you submit or pay the fee."
  },
  "guide_uploads_title": {
    "message": "Uploads"
  },
  "guide_visa_1": {
    "message": "Embassy checklists ask for a passport valid at least 90 days beyond the visa, with two blank pages. It must also cover your whole stay for the residence permit."
  },
  "guide_visa_2": {
    "message": "Apply for the permesso di soggiorno within 8 days of arriving in Italy."
  },
  "guide_visa_title": {
    "message": "Visa and residence permit"
  },
